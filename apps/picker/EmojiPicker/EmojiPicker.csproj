<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ModernEmojiPicker</AssemblyName>

    <!-- Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Resident tray app: prefer a small heap over GC throughput -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- Application Info -->
    <AssemblyTitle>Modern Emoji Picker</AssemblyTitle>
    <AssemblyDescription>Modern Unicode emoji picker for Windows</AssemblyDescription>
    <AssemblyProduct>Modern Emoji Picker</AssemblyProduct>
    <Authors>X CroSs</Authors>
    <Company>X CroSs</Company>
    <AssemblyCopyright>Copyright © X CroSs 2026</AssemblyCopyright>
    <AssemblyVersion>0.1.9.0</AssemblyVersion>
    <FileVersion>0.1.9.0</FileVersion>
    <Version>0.1.9</Version>
    <InformationalVersion>0.1.9</InformationalVersion>
  </PropertyGroup>

  <!-- WinForms is only used for the tray icon (App.xaml.cs imports it explicitly);
       drop the implicit global using so its types don't clash with WPF's -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ticket 14 will add new branded artwork. The imported Classic icon is
         intentionally not embedded or assigned to the Modern executable. -->
    <!-- Usage-popularity tier (0 = most used) keyed by emoji; parsed from
         Unicode's published emoji-frequency data
         (https://home.unicode.org/emoji/emoji-frequency/), supplemented with
         popular post-2018 emoji absent from that dataset. Search results are
         ordered by these tiers within each match class. -->
    <Resource Include="Resources\popularity.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VirtualizingWrapPanel" />
  </ItemGroup>

  <ItemGroup>
    <!-- Preserve repository-relative paths from the generated manifest. The
         runtime is offline and resolves every image through Emoji Asset Provider. -->
    <Content Include="..\..\..\data\emoji-baseline\17.0\emoji.json"
             Link="EmojiBaseline\data\emoji-baseline\17.0\emoji.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\vendor\noto-emoji\v2.051\png\128\**\*.png"
             Link="EmojiBaseline\vendor\noto-emoji\v2.051\png\128\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\vendor\noto-emoji\v2.051\png\512\**\*.png"
             Link="EmojiBaseline\vendor\noto-emoji\v2.051\png\512\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\vendor\noto-emoji\v2.051\third_party\region-flags\png\**\*.png"
             Link="EmojiBaseline\vendor\noto-emoji\v2.051\third_party\region-flags\png\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Trade a little allocation speed for a smaller retained heap (0-9; higher
       conserves more). Keeps the resident (idle-in-tray) footprint modest. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="6" />
  </ItemGroup>

</Project>
