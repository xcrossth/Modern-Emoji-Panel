{
  "name": "modern-emoji-renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:rendering": "node ./scripts/verify-rendering.mjs",
    "verify": "npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/chrome": "0.2.7",
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
