<Window x:Class="EmojiPicker.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Modern Emoji Picker" Width="520" Height="470"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="True">
    <StackPanel Margin="28">
        <TextBlock x:Name="Heading" Text="Welcome to Modern Emoji Picker" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="Intro" Margin="0,12,0,12" TextWrapping="Wrap"
                   Text="Your picker works locally and does not require an account or network connection."/>
        <TextBlock x:Name="HotkeyText" Margin="0,7" TextWrapping="Wrap" Text="• Press Win + . to open the picker. You can change or disable this in Settings."/>
        <TextBlock x:Name="ConflictText" Margin="0,7" TextWrapping="Wrap" Text="• If Classic Emoji Picker is running, Modern will not take its hotkey or stop it. Exit Classic first."/>
        <TextBlock x:Name="PasteText" Margin="0,7" TextWrapping="Wrap" Text="• Complex emoji use Temporary Paste. Clipboard restore is best-effort and never overwrites newer clipboard content."/>
        <TextBlock x:Name="StartupText" Margin="0,7" TextWrapping="Wrap" Text="• Portable mode does not start with Windows unless you enable it. Installer autostart may be prepared during installation."/>
        <TextBlock x:Name="SettingsText" Margin="0,7" TextWrapping="Wrap" Text="• Open Settings from the tray icon to control language, theme, skin tone, insertion, privacy, and local Activity Data."/>
        <TextBlock x:Name="PrivacyText" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                   Text="No account, cloud sync, telemetry, or automatic upload is used in v1."/>
        <Button x:Name="ContinueButton" Content="Continue" Width="110" HorizontalAlignment="Right" Margin="0,22,0,0" IsDefault="True" Click="Continue_Click"/>
    </StackPanel>
</Window>
