<Window x:Class="EmojiPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EmojiPicker"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="Modern Emoji Picker"
        Height="440"
        Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowActivated="True"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="MainWindow_MouseLeftButtonDown"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Deactivated="MainWindow_Deactivated"
        Loaded="MainWindow_Loaded">

    <Window.Resources>
        <!-- Category tab (bottom strip) -->
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="{Binding DisplayName}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="0,8">
                            <local:NotoEmojiImage AssetPath="{Binding IconAssetPath}"
                                                  DecodeSizeDip="23"
                                                  Width="23" Height="23"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="TabItem_MouseLeftButtonUp"/>
        </Style>

        <!-- Emoji cell in the grid -->
        <Style x:Key="EmojiItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Windows 10 style: a filled highlight square (no border
                             stroke), with the glyph filling most of the cell -->
                        <Border x:Name="Root"
                                Width="40" Height="40"
                                Margin="1"
                                Background="Transparent"
                                CornerRadius="2">
                            <Grid Width="32" Height="32">
                                <Border BorderBrush="{DynamicResource PlaceholderBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        ToolTip="{Binding Name}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAssetUnavailable, ElementName=Artwork}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="?"
                                               Foreground="{DynamicResource PlaceholderForegroundBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <local:NotoEmojiImage x:Name="Artwork"
                                                      AssetPath="{Binding AssetPath}"
                                                      DecodeSizeDip="32"
                                                      Width="32" Height="32"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <!-- After IsMouseOver so selection wins when both apply -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="EmojiItem_MouseLeftButtonUp"/>
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="EmojiItem_MouseRightButtonUp"/>
        </Style>

        <!-- Minimal theme-aware scrollbar so the dark grid doesn't show a light track -->
        <Style x:Key="ThemedScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource ScrollBarBackgroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource ScrollBarThumbBrush}"
                                                        CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Main container with rounded corners and shadow -->
        <Border Background="{DynamicResource WindowBackgroundBrush}"
                CornerRadius="8"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="315" ShadowDepth="3" Opacity="0.3" BlurRadius="5"/>
            </Border.Effect>

            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Box with watermark -->
                <Grid Grid.Row="0" Margin="10,10,28,5">
                    <TextBox x:Name="SearchBox"
                             Padding="8"
                             FontSize="12"
                             Background="{DynamicResource SearchBackgroundBrush}"
                             Foreground="{DynamicResource SearchForegroundBrush}"
                             CaretBrush="{DynamicResource SearchForegroundBrush}"
                             BorderBrush="{DynamicResource SearchBorderBrush}"
                             BorderThickness="1"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="Keep typing to find an emoji"
                               FontSize="12"
                               Foreground="{DynamicResource WatermarkForegroundBrush}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Category and the global default skin tone. Mixed-tone
                     sequences remain one-shot Variant Overrides on a tile. -->
                <DockPanel Grid.Row="1" Margin="12,4,12,2" LastChildFill="True">
                    <ComboBox x:Name="SkinTonePicker"
                              DockPanel.Dock="Right"
                              Width="148"
                              Height="26"
                              Margin="8,0,0,0"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="SkinTonePicker_SelectionChanged"
                              ToolTip="Default skin tone (Alt+T). Right-click or press Alt+Down on a supported tile for a one-shot mixed-tone Variant Override."
                              AutomationProperties.Name="Default skin tone"/>
                    <TextBlock x:Name="CategoryHeader"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource HeaderForegroundBrush}"/>
                </DockPanel>

                <!-- Emoji Grid (UI-virtualized: only visible cells are realized) -->
                <ListBox x:Name="EmojiGrid"
                         Grid.Row="2"
                         Margin="5,2,5,8"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLength="1,1"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         ItemContainerStyle="{StaticResource EmojiItemStyle}">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedScrollBar}"/>
                    </ListBox.Resources>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Border x:Name="AssetRepairPanel"
                        Grid.Row="2"
                        Margin="12"
                        Padding="18"
                        CornerRadius="6"
                        Background="{DynamicResource RepairBackgroundBrush}"
                        BorderBrush="{DynamicResource PlaceholderBorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed"
                        Panel.ZIndex="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Emoji artwork is unavailable"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource HeaderForegroundBrush}"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="AssetRepairMessage"
                                   Margin="0,8,0,0"
                                   Text="Repair or reinstall Modern Emoji Picker to restore the bundled Noto artwork."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource HeaderForegroundBrush}"
                                   TextAlignment="Center"
                                   AutomationProperties.LiveSetting="Assertive"/>
                    </StackPanel>
                </Border>

                <!-- Category Tabs at Bottom -->
                <ListBox x:Name="CategoryTabs"
                         Grid.Row="3"
                         Height="42"
                         Background="{DynamicResource TabStripBackgroundBrush}"
                         BorderThickness="0"
                         Focusable="False"
                         HorizontalAlignment="Stretch"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource TabItemStyle}"
                         SelectionChanged="CategoryTabs_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- One row, evenly divided: the 7 category tabs fill
                                 the full strip width instead of packing left -->
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>
        </Border>

        <!-- Close Button (top-right corner) -->
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,8,8,0"
                Width="20"
                Height="20"
                Content="×"
                FontSize="14"
                FontFamily="Segoe UI"
                Foreground="{DynamicResource CloseForegroundBrush}"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="CloseButton_Click"
                Cursor="Hand"/>
    </Grid>
</Window>
